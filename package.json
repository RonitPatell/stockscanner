{
  "name": "stockscanner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/*.test.mts",
    "landing:perf": "node scripts/landing-perf.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "ingest:worker": "node scripts/ingest-worker.mjs",
    "ingest:priority": "node scripts/priority-ingest-worker.mjs",
    "test:trader-feedback": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/trader-feedback.test.mts",
    "test:squawk-focus": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/squawk-focus.test.mts",
    "test:analogue": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/analogue.test.mts",
    "test:alert-strategy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/alert-strategy.test.mts",
    "test:reliability": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/reliability.test.mts",
    "test:dashboard-shell": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/dashboard-shell.test.mts",
    "test:catalyst-feed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/catalyst-feed-v3.test.mts",
    "test:judgment-present": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/judgment-presentation.test.mts",
    "test:focus-mode": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/focus-mode-v2.test.mts",
    "test:decision-drawer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/decision-drawer.test.mts",
    "test:visual-system": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/visual-system.test.mts",
    "test:e2e": "playwright test",
    "test:e2e:focus": "playwright test e2e/focus-mode-v2.spec.ts",
    "test:e2e:dashboard": "playwright test e2e/dashboard-shell.spec.ts",
    "test:e2e:decision-drawer": "playwright test e2e/decision-drawer.spec.ts",
    "test:e2e:visual": "playwright test e2e/visual-system.spec.ts --project=desktop",
    "test:e2e:visual:update": "playwright test e2e/visual-system.spec.ts --project=desktop --update-snapshots",
    "test:e2e:workflow": "node scripts/run-workflow-audit.mjs",
    "quote:stream": "node scripts/quote-stream.mjs",
    "realtime:worker": "node scripts/realtime-worker.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.52.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
